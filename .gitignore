# Raw PDBbind files and processed graphs are never versioned.
# data/index/ (indices + splits) and data/processed/*/meta.json ARE versioned.
data/raw/
data/processed/**
!data/processed/*/
!data/processed/*/meta.json

# Structure files anywhere in the repo
*.pdb
*.mol2
*.sdf
*.cif

# Serialized tensors / graphs
*.pt
*.pth

